{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topics",
  "type": "object",
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "description", "url"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["core", "more"] },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "accent": { "type": "string" },
          "icon": { "type": "string" },
          "keywords": { "type": "string" },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "subtopics"],
              "properties": {
                "name": { "type": "string" },
                "title": { "type": "string" },
                "subtopics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "name", "level", "status"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                      "name": { "type": "string", "minLength": 3 },
                      "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
                      "status": { "type": "string", "enum": ["published", "planned"] },
                      "url": { "type": "string" }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": { "status": { "const": "published" } }
                        },
                        "then": {
                          "required": ["url"]
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
